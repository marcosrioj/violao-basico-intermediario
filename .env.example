# Copie para .env.local. Todos os valores abaixo são fictícios.
# Sem Supabase configurado, apenas apresentação pública e privacidade ficam disponíveis.
# Aulas e ferramentas exigem login e matrícula em turma (ou papel de professor).
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_substitua_pela_chave_publicavel
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Na Vercel (Production), use a origem pública definitiva e faça um novo deploy.
# O mesmo domínio deve estar em Supabase > Authentication > URL Configuration.
# Não use URL temporária de deployment nem endereço de equipe no Site URL.

# A aplicação NÃO precisa de service_role nem da senha do PostgreSQL.
# OAuth Google: Client ID/Secret são configurados no painel Supabase.
# SMTP: host, porta, usuário e senha ficam no painel Supabase, nunca aqui no Git.
